# Copy to ".env" and fill in. NEVER share or commit the real .env file.

# ---- Core (required in production) ----
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DATABASE_URL=postgres://user:password@host:5432/dbname

SITE_URL=https://yourdomain.com
# True = new accounts must click the emailed link before they can log in
ACCOUNTS_REQUIRE_EMAIL_VERIFICATION=True

# ---- Security ----
FORCE_HTTPS=True
HSTS_SECONDS=3600
TRUST_PROXY=False
ADMIN_URL=admin/

# ---- Email (contact form notifications) ----
# Gmail: use an App Password (16 letters). Spaces and quotes are removed for you.
MAIL_TO=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
